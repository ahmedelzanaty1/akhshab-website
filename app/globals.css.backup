:root{
  --bg:#0E0A07;
  --bg-alt:#17110C;
  --panel:#1D1610;
  --wood-deep:#3E2415;
  --wood:#7A4A28;
  --wood-light:#A9713F;
  --cream:#EFE6D6;
  --cream-dim:#C9BCA6;
  --gold:#C6963F;
  --gold-bright:#E7C078;
  --line:rgba(198,150,63,.22);
  --muted:#8A7B68;
  --radius:2px;
  --ease:cubic-bezier(.19,1,.22,1);
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto;}
  *{animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important;}
}
body{
  background:var(--bg);
  color:var(--cream);
  font-family:'Tajawal',sans-serif;
  font-weight:400;
  line-height:1.7;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}
::selection{background:var(--gold);color:#140D08;}
a{color:inherit;text-decoration:none;}
ul{list-style:none;}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}
input,select,textarea{font-family:inherit;}
img{max-width:100%;display:block;}
:focus-visible{outline:2px solid var(--gold-bright);outline-offset:3px;}

h1,h2,h3{font-family:'Cairo',sans-serif;font-weight:800;letter-spacing:-.01em;}

.wrap{max-width:1180px;margin:0 auto;padding:0 32px;}
@media (max-width:640px){.wrap{padding:0 20px;}}

.hairline{height:1px;background:var(--line);border:none;}

/* ---------- NAV ---------- */
header{
  position:fixed;inset-inline:0;top:0;z-index:100;
  padding:22px 0;
  transition:padding .4s var(--ease), background .4s var(--ease), border-color .4s var(--ease);
  border-bottom:1px solid transparent;
}
header.scrolled{
  padding:13px 0;
  background:rgba(14,10,7,.86);
  backdrop-filter:blur(14px);
  border-color:var(--line);
}
header .wrap{display:flex;align-items:center;justify-content:space-between;gap:24px;}
.brand{display:flex;align-items:center;gap:12px;}
.brand img{width:44px;height:44px;border-radius:50%;transition:width .4s var(--ease), height .4s var(--ease);}
header.scrolled .brand img{width:36px;height:36px;}
.brand-name{font-family:'Cairo',sans-serif;font-weight:900;font-size:18px;letter-spacing:.01em;}
.brand-name span{display:block;font-family:'Tajawal',sans-serif;font-weight:400;font-size:10.5px;color:var(--muted);letter-spacing:.15em;margin-top:1px;}

nav.primary{display:flex;align-items:center;gap:36px;}
nav.primary a{
  position:relative;font-size:14.5px;color:var(--cream-dim);
  padding:6px 0;transition:color .25s;
}
nav.primary a::after{
  content:'';position:absolute;bottom:0;right:0;left:0;height:1px;
  background:var(--gold-bright);transform:scaleX(0);transform-origin:left;
  transition:transform .35s var(--ease);
}
nav.primary a:hover{color:var(--cream);}
nav.primary a:hover::after{transform:scaleX(1);}

.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:13px 26px;font-size:14px;font-weight:700;border-radius:var(--radius);
  transition:transform .3s var(--ease), background .3s, border-color .3s, color .3s;
  white-space:nowrap;
}
.btn-gold{background:var(--gold);color:#140D08;}
.btn-gold:hover{background:var(--gold-bright);transform:translateY(-2px);}
.btn-ghost{border:1px solid var(--line);color:var(--cream);}
.btn-ghost:hover{border-color:var(--gold);color:var(--gold-bright);transform:translateY(-2px);}
.btn-block{width:100%;}
.btn:disabled{opacity:.6;cursor:not-allowed;transform:none;}

.nav-cta{display:flex;align-items:center;gap:18px;}
.menu-toggle{display:none;flex-direction:column;gap:5px;width:26px;}
.menu-toggle span{height:1.5px;background:var(--cream);width:100%;transition:transform .3s,opacity .3s;}
@media (max-width:860px){
  nav.primary{display:none;}
  .menu-toggle{display:flex;}
}
@media (max-width:640px){
  .nav-cta .btn-gold{padding:10px 16px;font-size:12.5px;}
}

.mobile-menu{
  position:fixed;inset:0;z-index:99;background:var(--bg-alt);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:30px;
  opacity:0;pointer-events:none;transition:opacity .4s var(--ease);
}
.mobile-menu.open{opacity:1;pointer-events:auto;}
.mobile-menu a{font-family:'Cairo',sans-serif;font-size:26px;font-weight:700;}

/* ---------- HERO ---------- */
.hero{
  min-height:100vh;display:flex;align-items:center;position:relative;
  padding:150px 0 90px;
  background:
    radial-gradient(ellipse 60% 50% at 80% 15%, rgba(122,74,40,.28), transparent 60%),
    radial-gradient(ellipse 50% 40% at 10% 90%, rgba(198,150,63,.10), transparent 60%),
    var(--bg);
}
.hero .wrap{display:grid;grid-template-columns:1.15fr .85fr;gap:64px;align-items:center;}
@media (max-width:900px){.hero .wrap{grid-template-columns:1fr;gap:56px;text-align:center;}}

.hero-eyebrow{
  font-size:13px;color:var(--gold);font-weight:600;letter-spacing:.02em;
  display:flex;align-items:center;gap:10px;margin-bottom:22px;
  opacity:0;animation:fadeUp .8s var(--ease) .15s forwards;
}
@media(max-width:900px){.hero-eyebrow{justify-content:center;}}
.hero-eyebrow i{width:26px;height:1px;background:var(--gold);display:block;}

.hero h1{
  font-size:clamp(34px,5vw,58px);line-height:1.18;color:var(--cream);
  opacity:0;animation:fadeUp .9s var(--ease) .3s forwards;
}
.hero p.lead{
  margin-top:22px;max-width:46ch;color:var(--cream-dim);font-size:16.5px;line-height:1.9;
  opacity:0;animation:fadeUp .9s var(--ease) .48s forwards;
}
@media(max-width:900px){.hero p.lead{max-width:none;margin-inline:auto;}}
.hero-actions{
  display:flex;gap:16px;margin-top:38px;flex-wrap:wrap;
  opacity:0;animation:fadeUp .9s var(--ease) .64s forwards;
}
@media(max-width:900px){.hero-actions{justify-content:center;}}

.hero-mark{position:relative;display:flex;align-items:center;justify-content:center;}
.hero-mark::before{
  content:'';position:absolute;inset:-6%;border:1px solid var(--line);border-radius:50%;
  opacity:0;animation:ringIn 1.1s var(--ease) .5s forwards;
}
.hero-mark-inner{
  position:relative;width:min(380px,72vw);aspect-ratio:1;border-radius:50%;overflow:hidden;
  opacity:0;transform:scale(.82) rotate(-10deg);
  animation:markIn 1.2s var(--ease) .25s forwards;
  box-shadow:0 40px 90px -30px rgba(0,0,0,.7);
}
.hero-mark-inner img{width:100%;height:100%;object-fit:cover;}
.hero-mark-inner::after{
  content:'';position:absolute;inset:0;border-radius:50%;
  background:linear-gradient(115deg,transparent 40%,rgba(231,192,120,.55) 50%,transparent 60%);
  transform:translateX(-120%);
  animation:sweep 1.6s ease .95s 1;
}
@keyframes fadeUp{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}
@keyframes markIn{from{opacity:0;transform:scale(.82) rotate(-10deg);}to{opacity:1;transform:scale(1) rotate(0);}}
@keyframes ringIn{from{opacity:0;transform:scale(.9);}to{opacity:1;transform:scale(1);}}
@keyframes sweep{to{transform:translateX(120%);}}

.scroll-cue{
  position:absolute;bottom:34px;right:50%;transform:translateX(50%);
  display:flex;flex-direction:column;align-items:center;gap:10px;color:var(--muted);font-size:11.5px;
  opacity:0;animation:fadeUp .8s var(--ease) 1.2s forwards;
}
.scroll-cue i{width:1px;height:34px;background:linear-gradient(var(--gold),transparent);position:relative;overflow:hidden;display:block;}
.scroll-cue i::after{content:'';position:absolute;top:-100%;right:0;left:0;height:50%;background:var(--gold-bright);animation:cueMove 1.8s ease-in-out infinite;}
@keyframes cueMove{50%{top:100%;}100%{top:100%;}}

/* ---------- MARQUEE ---------- */
.marquee-strip{
  border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  padding:18px 0;overflow:hidden;white-space:nowrap;background:var(--bg-alt);
}
.marquee-track{display:inline-flex;animation:marquee 32s linear infinite;}
.marquee-track span{
  font-family:'Cairo',sans-serif;font-weight:700;font-size:15px;color:var(--cream-dim);
  padding:0 28px;display:inline-flex;align-items:center;gap:28px;
}
.marquee-track span i{width:5px;height:5px;background:var(--gold);border-radius:50%;display:inline-block;}
@keyframes marquee{from{transform:translateX(0);}to{transform:translateX(-50%);}}

/* ---------- SECTION shared ---------- */
section{padding:120px 0;position:relative;}
@media(max-width:768px){section{padding:80px 0;}}
.section-head{max-width:640px;margin-bottom:64px;}
.section-head.center{margin-inline:auto;text-align:center;}
.section-head h2{font-size:clamp(28px,3.6vw,42px);line-height:1.25;color:var(--cream);}
.section-head p{margin-top:16px;color:var(--cream-dim);font-size:15.5px;}
.reveal{opacity:0;transform:translateY(22px);transition:opacity .8s var(--ease),transform .8s var(--ease);}
.reveal.in{opacity:1;transform:translateY(0);}

/* ---------- ABOUT / STATS ---------- */
.about{background:var(--bg-alt);}
.about-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:start;}
@media(max-width:900px){.about-grid{grid-template-columns:1fr;gap:44px;}}
.about-copy p{color:var(--cream-dim);font-size:15.5px;margin-top:16px;max-width:50ch;}
.about-copy p:first-child{margin-top:0;}

.stat-row{display:flex;flex-wrap:wrap;}
.stat{flex:1 1 160px;padding:0 26px 26px 0;border-inline-end:1px solid var(--line);margin-inline-end:26px;margin-bottom:26px;}
.stat:last-child{border-inline-end:none;}
.stat .num{font-family:'Cairo',sans-serif;font-weight:900;font-size:clamp(30px,4vw,44px);color:var(--gold-bright);line-height:1;}
.stat .label{margin-top:10px;font-size:13.5px;color:var(--muted);max-width:20ch;}

/* ---------- COLLECTIONS ---------- */
.collections-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:2px;background:var(--line);}
.collection-card{
  position:relative;background:var(--panel);padding:42px 28px;min-height:300px;
  display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden;
  transition:background .5s, transform .2s ease-out;
}
.collection-card .glyph{
  font-family:'Cairo',sans-serif;font-weight:900;font-size:96px;line-height:1;color:transparent;
  -webkit-text-stroke:1.4px var(--line);position:absolute;top:18px;left:24px;
  transition:transform .6s var(--ease), -webkit-text-stroke-color .5s;
}
.collection-card:hover .glyph{-webkit-text-stroke-color:var(--gold);transform:translateY(-6px) scale(1.04);}
.collection-card:hover{background:var(--wood-deep);}
.collection-card h3{position:relative;font-size:19px;color:var(--cream);z-index:1;}
.collection-card .tag{position:relative;z-index:1;margin-top:8px;font-size:13px;color:var(--cream-dim);}
.collection-card .go{
  position:relative;z-index:1;margin-top:18px;font-size:13px;color:var(--gold-bright);
  display:inline-flex;align-items:center;gap:6px;opacity:0;transform:translateY(6px);
  transition:opacity .4s,transform .4s;
}
.collection-card:hover .go{opacity:1;transform:translateY(0);}

/* ---------- AI ASSISTANT ---------- */
.ai-section{background:var(--bg-alt);}
.ai-panel{
  background:var(--panel);border:1px solid var(--line);border-radius:6px;
  padding:36px;display:grid;grid-template-columns:1fr 1fr;gap:40px;
}
@media(max-width:860px){.ai-panel{grid-template-columns:1fr;padding:26px;}}
.ai-form label{display:block;font-size:12.5px;color:var(--muted);margin-bottom:10px;}
.chip-group{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:22px;}
.chip{
  padding:9px 16px;border:1px solid var(--line);border-radius:30px;font-size:13.5px;color:var(--cream-dim);
  transition:all .25s;
}
.chip:hover{border-color:var(--gold);color:var(--cream);}
.chip.active{background:var(--gold);border-color:var(--gold);color:#140D08;font-weight:700;}
.ai-form textarea{
  width:100%;background:var(--bg);border:1px solid var(--line);border-radius:4px;color:var(--cream);
  padding:13px 16px;font-size:14px;min-height:80px;resize:vertical;transition:border-color .25s;
}
.ai-form textarea:focus{border-color:var(--gold);}
.ai-form .btn{margin-top:20px;}

.ai-result{min-height:220px;display:flex;flex-direction:column;justify-content:center;}
.ai-placeholder{color:var(--muted);font-size:14px;text-align:center;padding:20px;}
.ai-placeholder .big{font-size:34px;display:block;margin-bottom:14px;}

.typing{display:flex;gap:6px;align-items:center;justify-content:center;padding:30px 0;}
.typing span{width:7px;height:7px;background:var(--gold);border-radius:50%;animation:blink 1.2s infinite ease-in-out;}
.typing span:nth-child(2){animation-delay:.15s;}
.typing span:nth-child(3){animation-delay:.3s;}
@keyframes blink{0%,80%,100%{opacity:.25;transform:scale(.85);}40%{opacity:1;transform:scale(1);}}

.suggestion-card{
  border-top:1px solid var(--line);padding:16px 0;opacity:0;transform:translateY(10px);
  animation:fadeUp .6s var(--ease) forwards;
}
.suggestion-card:first-child{border-top:none;padding-top:0;}
.suggestion-card h4{font-family:'Cairo',sans-serif;font-size:15.5px;color:var(--gold-bright);}
.suggestion-card p{margin-top:6px;font-size:13.5px;color:var(--cream-dim);}
.suggestion-card .mats{margin-top:10px;display:flex;flex-wrap:wrap;gap:6px;}
.suggestion-card .mats span{font-size:11.5px;padding:4px 10px;background:var(--bg);border-radius:20px;color:var(--muted);}
.ai-error{font-size:13.5px;color:#C97A5A;text-align:center;padding:16px 0;}
.ai-note{margin-top:18px;font-size:11.5px;color:var(--muted);text-align:center;}

/* ---------- SOCIAL / GALLERY ---------- */
.social{text-align:center;}
.social-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:3px;max-width:640px;margin:0 auto 40px;}
.social-tile{aspect-ratio:1;border-radius:2px;overflow:hidden;}
.social-tile img{width:100%;height:100%;object-fit:cover;}
.social-tile.g1{background:linear-gradient(135deg,var(--wood),var(--wood-deep));}
.social-tile.g2{background:linear-gradient(135deg,var(--gold),var(--wood));}
.social-tile.g3{background:linear-gradient(135deg,var(--wood-deep),var(--bg));}
.social-tile.g4{background:linear-gradient(135deg,var(--wood-light),var(--wood-deep));}
.social-tile.g5{background:linear-gradient(135deg,var(--bg-alt),var(--wood));}
.social-tile.g6{background:linear-gradient(135deg,var(--gold-bright),var(--wood-deep));}
.social-links{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;}
.social-link{
  display:inline-flex;align-items:center;gap:10px;padding:12px 22px;border:1px solid var(--line);
  border-radius:30px;font-size:14px;transition:all .3s;
}
.social-link:hover{border-color:var(--gold);color:var(--gold-bright);transform:translateY(-2px);}
.social-link svg{width:17px;height:17px;}

/* ---------- BOOKING ---------- */
.booking-wrap{display:grid;grid-template-columns:.85fr 1.15fr;gap:60px;}
@media(max-width:900px){.booking-wrap{grid-template-columns:1fr;gap:40px;}}
.booking-info h2{font-size:clamp(26px,3.4vw,36px);}
.booking-info p{margin-top:16px;color:var(--cream-dim);font-size:15px;max-width:38ch;}
.booking-info ul{margin-top:28px;display:flex;flex-direction:column;gap:14px;}
.booking-info li{display:flex;align-items:center;gap:12px;font-size:14px;color:var(--cream-dim);}
.booking-info li i{width:6px;height:6px;background:var(--gold);border-radius:50%;flex:none;display:block;}

form.booking-form{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:34px;position:relative;overflow:hidden;}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
@media(max-width:540px){.field-row{grid-template-columns:1fr;}}
.field{margin-bottom:18px;}
.field label{display:block;font-size:12.5px;color:var(--muted);margin-bottom:8px;}
.field input,.field select,.field textarea{
  width:100%;background:var(--bg);border:1px solid var(--line);border-radius:4px;color:var(--cream);
  padding:12px 14px;font-size:14px;transition:border-color .25s;
}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--gold);}
.field textarea{min-height:90px;resize:vertical;}

.form-success{
  position:absolute;inset:0;background:var(--panel);display:flex;flex-direction:column;align-items:center;
  justify-content:center;gap:16px;opacity:0;pointer-events:none;transition:opacity .4s;text-align:center;padding:30px;
}
.form-success.show{opacity:1;pointer-events:auto;}
.check-circle{width:60px;height:60px;border-radius:50%;border:1.5px solid var(--gold);display:flex;align-items:center;justify-content:center;}
.check-circle svg{width:26px;height:26px;}
.check-circle path{stroke-dasharray:30;stroke-dashoffset:30;animation:draw .6s ease forwards .2s;}
@keyframes draw{to{stroke-dashoffset:0;}}
.form-success h4{font-family:'Cairo',sans-serif;font-size:18px;}
.form-success p{color:var(--cream-dim);font-size:14px;max-width:32ch;}

/* ---------- FOOTER ---------- */
footer{padding:70px 0 30px;background:var(--bg-alt);}
.footer-top{display:flex;justify-content:space-between;flex-wrap:wrap;gap:40px;padding-bottom:46px;}
.footer-brand{display:flex;align-items:center;gap:12px;}
.footer-brand img{width:42px;height:42px;border-radius:50%;}
.footer-cols{display:flex;gap:60px;flex-wrap:wrap;}
.footer-col h5{font-size:12.5px;color:var(--muted);margin-bottom:14px;letter-spacing:.03em;}
.footer-col a,.footer-col p{display:block;font-size:14px;color:var(--cream-dim);margin-bottom:10px;}
.footer-col a:hover{color:var(--gold-bright);}
.footer-bottom{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;padding-top:24px;font-size:12.5px;color:var(--muted);}
.footer-bottom .social-links{gap:10px;}
.footer-bottom .social-link{padding:9px;border-radius:50%;}
.footer-bottom .social-link span{display:none;}

/* ---------- GALLERY (categorized) ---------- */
.gallery-tabs{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:30px;justify-content:center;}
.gallery-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;margin-bottom:40px;}
.gallery-tile{
  position:relative;aspect-ratio:1;border-radius:3px;overflow:hidden;border:1px solid var(--line);
  opacity:0;animation:galleryFadeIn .6s var(--ease) forwards;
}
.gallery-tile img{width:100%;height:100%;object-fit:cover;transition:transform .5s var(--ease);}
.gallery-tile:hover img{transform:scale(1.08);}
.gallery-tile .cat-label{
  position:absolute;bottom:8px;right:8px;font-size:11px;color:var(--gold-bright);
  background:rgba(14,10,7,.75);padding:3px 10px;border-radius:20px;
  opacity:0;transform:translateY(6px);transition:opacity .3s,transform .3s;
}
.gallery-tile:hover .cat-label{opacity:1;transform:translateY(0);}
@keyframes galleryFadeIn{from{opacity:0;transform:scale(.92);}to{opacity:1;transform:scale(1);}}

/* ---------- PRODUCTS ---------- */
.product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:18px;}
.product-card{
  background:var(--panel);border:1px solid var(--line);border-radius:6px;overflow:hidden;
  transition:transform .35s var(--ease),border-color .35s;cursor:pointer;
}
.product-card:hover{transform:translateY(-4px);border-color:var(--gold);}
.product-card .thumb{aspect-ratio:4/3;background:linear-gradient(135deg,var(--wood),var(--wood-deep));position:relative;overflow:hidden;}
.product-card .thumb img{width:100%;height:100%;object-fit:cover;}
.product-card .badge-offer{
  position:absolute;top:10px;left:10px;background:var(--gold);color:#140D08;font-size:11px;
  font-weight:800;padding:4px 10px;border-radius:20px;font-family:'Cairo',sans-serif;
}
.product-card .body{padding:18px;}
.product-card .cat{font-size:11.5px;color:var(--muted);}
.product-card h4{font-family:'Cairo',sans-serif;font-size:15.5px;margin-top:4px;color:var(--cream);}
.product-card .price-row{margin-top:10px;font-size:14px;}
.product-card .price-row .old{text-decoration:line-through;color:var(--muted);margin-left:8px;font-size:12.5px;}
.product-card .price-row .now{color:var(--gold-bright);font-weight:800;font-family:'Cairo',sans-serif;}

/* ---------- AI mode toggle & image result ---------- */
.ai-mode-toggle{display:flex;gap:9px;margin-bottom:26px;}
.ai-mode-toggle button{
  flex:1;padding:11px;border:1px solid var(--line);border-radius:4px;font-size:13.5px;color:var(--cream-dim);
  transition:all .25s;
}
.ai-mode-toggle button.active{background:var(--gold);border-color:var(--gold);color:#140D08;font-weight:700;}
.ai-image-result{width:100%;border-radius:4px;overflow:hidden;border:1px solid var(--line);}
.ai-image-result img{width:100%;display:block;}
.ai-quota{font-size:12px;color:var(--muted);text-align:center;margin-top:12px;}

/* ---------- COLLECTION STACKS (card-fan gallery) ---------- */
.stacks-row{display:flex;flex-wrap:wrap;gap:44px;justify-content:center;margin-bottom:44px;}
.stack{cursor:pointer;text-align:center;}
.stack-frame{
  position:relative;width:190px;height:230px;margin:0 auto 16px;
}
.stack-card{
  position:absolute;inset:0;border-radius:6px;overflow:hidden;border:1px solid var(--line);
  box-shadow:0 18px 34px -14px rgba(0,0,0,.6);
  transition:transform .5s var(--ease), box-shadow .5s var(--ease);
  opacity:0;animation:stackIn .7s var(--ease) forwards;
}
.stack-card img{width:100%;height:100%;object-fit:cover;display:block;}
.stack:hover .stack-card{box-shadow:0 26px 44px -14px rgba(0,0,0,.7);}
@keyframes stackIn{from{opacity:0;transform:translateY(14px) rotate(0deg) scale(.9);}}
.stack-label{font-family:'Cairo',sans-serif;font-size:15px;color:var(--cream);}
.stack-count{font-size:12px;color:var(--muted);margin-top:2px;}

/* ---------- LIGHTBOX ---------- */
.lightbox-overlay{
  position:fixed;inset:0;z-index:200;background:rgba(10,7,5,.92);
  display:flex;align-items:center;justify-content:center;padding:30px;
  animation:fadeUp .3s ease;
}
.lightbox-panel{
  background:var(--panel);border:1px solid var(--line);border-radius:8px;
  max-width:900px;width:100%;max-height:85vh;overflow-y:auto;padding:30px;position:relative;
}
.lightbox-close{
  position:absolute;top:16px;left:16px;width:34px;height:34px;border-radius:50%;
  background:var(--bg);border:1px solid var(--line);color:var(--cream);font-size:18px;
  display:flex;align-items:center;justify-content:center;
}
.lightbox-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin-top:20px;}
.lightbox-grid img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:4px;}

/* ---------- PRODUCT MODAL (carousel) ---------- */
.product-modal-img-wrap{position:relative;border-radius:6px;overflow:hidden;background:var(--bg);}
.product-modal-img-wrap img{width:100%;max-height:52vh;object-fit:contain;display:block;margin:0 auto;}
.carousel-nav{
  position:absolute;top:50%;transform:translateY(-50%);width:38px;height:38px;border-radius:50%;
  background:rgba(14,10,7,.75);color:var(--cream);display:flex;align-items:center;justify-content:center;font-size:18px;
}
.carousel-nav.prev{right:12px;}
.carousel-nav.next{left:12px;}
.carousel-dots{display:flex;gap:6px;justify-content:center;margin-top:14px;}
.carousel-dots span{width:6px;height:6px;border-radius:50%;background:var(--line);}
.carousel-dots span.active{background:var(--gold);}
